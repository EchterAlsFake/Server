# Import beside managed-sites.caddy. Does not handle api.pornfetch.to.
pornfetch.to {
    import application_defaults

    # Public immutable release files bypass Flask/Gunicorn entirely.
    handle_path /downloads/* {
        root * /srv/pornfetch-downloads/public
        @artifact file
        header @artifact {
            Content-Disposition "attachment"
            Cache-Control "public, max-age=31536000, immutable"
            X-Robots-Tag "noindex"
            X-Content-Type-Options "nosniff"
        }
        file_server
    }

    handle_path /repo/android/metadata/* {
        root * /srv/pornfetch-downloads/android-updates/current/metadata
        header X-Robots-Tag "noindex"
        header Cache-Control "no-store"
        file_server
    }
    handle_path /repo/android/targets/* {
        root * /srv/pornfetch-downloads/android-updates/targets
        header X-Robots-Tag "noindex"
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    @artifact_upload {
        path /ci/website-releases/*/files/*
        method PUT
    }
    request_body @artifact_upload {
        # Match WEBSITE_MAX_ARTIFACT_BYTES; ordinary requests stay at 200 KiB.
        max_size 2147483648
    }

    # Retire stale copies of the former IP-derived visitor counter.
    @legacy_visit path /__eaf/visit /__eaf/visit.js
    handle @legacy_visit {
        respond 410
    }

    @aggregate_metrics path /_metrics/event
    handle @aggregate_metrics {
        log_skip
        request_body {
            max_size 256B
        }
        reverse_proxy 127.0.0.1:8000 {
            header_up -Cookie
            header_up -Authorization
            header_up -Referer
            header_up -Forwarded
            header_up -X-Real-IP
            header_up -True-Client-IP
            header_up -CF-Connecting-IP
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Host
            header_up X-Forwarded-Proto https
        }
    }
    handle {
        @killswitch path /killswitch /killswitch/*
        respond @killswitch 404
        reverse_proxy 127.0.0.1:8000 {
            header_up -Forwarded
            header_up -X-Real-IP
            header_up -True-Client-IP
            header_up -CF-Connecting-IP
            header_up -X-Forwarded-Prefix
            header_up -X-Forwarded-Port
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto https
        }
    }
}

www.pornfetch.to {
    import application_defaults
    redir https://pornfetch.to{uri} 308
}
