+def test_visit_tokens_differ_across_hosts_and_days(app, monkeypatch):
+    from datetime import UTC, datetime, timedelta
+    import dashboard.app as app_module
+    import dashboard.store as store_module
+    first_day = datetime(2026, 11, 1, 12, tzinfo=UTC)
+    class Clock:
+        value = first_day
+        @classmethod
+        def now(cls, tz=None):
+            return cls.value
+    monkeypatch.setattr(app_module, "datetime", Clock)
+    monkeypatch.setattr(store_module, "utc_now", lambda: Clock.value)
+    client = app.test_client()
+    store = Store(app.extensions["dashboard_settings"].database_path)
+    for host in ("echteralsfake.me", "vplan.echteralsfake.me"):
+        for _ in range(2):
+            assert client.post("/__eaf/visit", json={}, headers={"Host": host, "Origin": f"https://{host}"}).status_code == 204
+    with store.connect() as db:
+        tokens = [row[0] for row in db.execute("SELECT token_hash FROM visitor_seen")]
+        assert len(tokens) == 2 and tokens[0] != tokens[1]
+        assert db.execute("SELECT SUM(value) FROM daily_usage").fetchone()[0] == 2
+    Clock.value += timedelta(days=1)
+    assert client.post("/__eaf/visit", json={}, headers={"Host": "echteralsfake.me", "Origin": "https://echteralsfake.me"}).status_code == 204
+    with store.connect() as db:
+        rows = db.execute("SELECT day,token_hash FROM visitor_seen").fetchall()
+        assert len(rows) == 1 and rows[0][0] == "2026-11-02"
+        assert rows[0][1] not in tokens
+        assert db.execute("SELECT SUM(value) FROM daily_usage").fetchone()[0] == 3
+
+
+def test_purge_visitors_without_new_visit_preserves_aggregate(app, monkeypatch):
+    from datetime import UTC, datetime, timedelta
+    import dashboard.store as store_module
+    today = datetime(2026, 11, 1, 12, tzinfo=UTC)
+    monkeypatch.setattr(store_module, "utc_now", lambda: today - timedelta(days=1))
+    store = Store(app.extensions["dashboard_settings"].database_path)
+    store.record_visit("echteralsfake.me", "page", "old-test-value")
+    monkeypatch.setattr(store_module, "utc_now", lambda: today)
+    assert store.purge_visitors() == 1
+    assert store.purge_visitors() == 0
+    with store.connect() as db:
+        assert db.execute("SELECT COUNT(*) FROM visitor_seen").fetchone()[0] == 0
+        assert db.execute("SELECT SUM(value) FROM daily_usage").fetchone()[0] == 1
+    store.record_visit("echteralsfake.me", "page", "current-test-value")
+    assert store.purge_visitors() == 0
 
