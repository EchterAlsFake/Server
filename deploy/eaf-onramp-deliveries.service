[Unit]
Description=Retry beta license delivery and purge expired Onramp checkout data
After=network-online.target eaf-server.service
ConditionPathExists=/srv/server/.env

[Service]
Type=oneshot
User=eaf-server
Group=eaf-server
WorkingDirectory=/srv/server
Environment=PF_SERVER_DATA_DIR=/srv/server/data
Environment=PF_SERVER_DB=/srv/server/data/server.db
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/server/.venv/bin/python -m flask --app main retry-onramp-deliveries
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/server/data
PrivateTmp=true
