[Unit]
Description=Verify Patreon Shop activation and deliver licenses
After=pornfetch-web.service
Requisite=pornfetch-web.service
PartOf=pornfetch-web.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/podman exec pornfetch-web test -f /app/pf_server/patreon_shop.py
ExecStart=/usr/bin/podman exec --user 0 pornfetch-web /entrypoint-wrapper.sh /drop-privileges 1000 1000 python3 -m flask --app main:app process-patreon-shop
TimeoutStartSec=10min
SuccessExitStatus=143 SIGTERM
NoNewPrivileges=true
