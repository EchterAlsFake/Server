# Core application state
SECRET_KEY=replace-with-a-long-random-value
PF_SERVER_DATA_DIR=.
# PF_SERVER_DB=/absolute/path/to/server.db
CHECKLIST_AUTH=replace-with-a-strong-password
CI_TOKEN=replace-with-a-random-token
RATELIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO

# Checkout tax-country evidence. Leave CHECKOUT_IP_HEADER empty only when the
# application directly receives the public client address in REMOTE_ADDR.
CHECKOUT_IP_HEADER=X-Forwarded-For
# GEOIP_DATABASE_PATH=/absolute/path/to/dbip-city-lite.mmdb
GEOIP_DATABASE_LABEL=

# Legacy application update feed lookup only; website downloads use the local catalog
GITHUB_TOKEN=

# A base64-encoded raw 32-byte Ed25519 private key
LICENSE_PRIVATE_KEY_B64=

# Payment origin and NOWPayments
APP_DOMAIN=https://pornfetch.to
# Public content can be indexed while payments remain in sandbox. Disable on staging.
SEO_INDEXING_ENABLED=true
API_DOMAIN=https://api.echteralsfake.me
NOWPAYMENTS_SANDBOX=true
# Keep false for real NOWPayments sandbox verification; never enable in production.
NOWPAYMENTS_LOCAL_SIMULATION_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# SMTP license delivery
LICENSE_SMTP_HOST=
LICENSE_SMTP_PORT=587
LICENSE_SMTP_USERNAME=
LICENSE_SMTP_PASSWORD=
LICENSE_EMAIL_FROM=
LICENSE_MAIL_PROVIDER_NAME=
LICENSE_SMTP_STARTTLS=true
LICENSE_SMTP_SSL=false

# Optional real-money Banxa lifetime-license checkout (never enable with NOWPayments sandbox).
# Verify the exact Polygon USDC token/contract and fee deductions end to end first.
ONRAMP_ENABLED=false
ONRAMP_POLYGON_USDC_VERIFIED=false
# Generate once: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key stable and backed up while encrypted orders, withdrawals or deliveries remain.
ONRAMP_ENCRYPTION_KEY=

# Required delivery, retained order contacts and withdrawal declarations: stable Fernet key.
# Falls back to ONRAMP_ENCRYPTION_KEY if unset. SMTP settings above are also needed.
LICENSE_DELIVERY_ENCRYPTION_KEY=

# Independent website distribution. Keep API_DOMAIN pointed at the payment API.
WEBSITE_RELEASES_DIR=/srv/pornfetch-downloads
WEBSITE_RELEASE_TOKEN=
WEBSITE_MAX_ARTIFACT_BYTES=2147483648

# Public read-only onion mirror (keep APP_DOMAIN on HTTPS).
ONION_ORIGIN=http://pornfetchc5ct7s7uiervf4ziymmus5gy33gyqc6vkdtqyr5pbxrxmid.onion

# Patreon Shop email and browser license recovery (independent of membership webhooks).
PATREON_SHOP_ENABLED=false
PATREON_SHOP_LOOKUP_KEY=
PATREON_SHOP_PRODUCT_VARIANT_ID=
# Live mode requires the specific HTTPS Patreon Shop product URL, not the Shop homepage.
PATREON_SHOP_PRODUCT_URL=https://www.patreon.com/c/echteralsfake/shop
# Worker-only Netscape cookies export; owned by worker user, chmod 600.
PATREON_SHOP_COOKIE_FILE=

# Extra exact staging hostnames, separated by commas; forwarded Host is ignored.
ADDITIONAL_TRUSTED_HOSTS=

# Refreshed hourly with flask update-tor-exits. Missing/stale data blocks crypto payments.
# TOR_EXIT_LIST_PATH=/absolute/path/to/tor-exits.json
